# Copy to web/.env.local and fill in. Never commit the filled file.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is public
# by definition. The anon key belongs there; row-level security is what protects
# the data behind it.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security entirely. It may appear
# only in server components, server actions and route handlers. If it ever
# reaches a NEXT_PUBLIC_ variable or a "use client" file, every student record in
# the database is public. CI greps for this (plan §4, scripts/check-service-role.sh).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENGINE_BASE_URL=
ENGINE_SHARED_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
