# Copy to engine/.env and fill in. Never commit the filled file.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. It belongs here and in
# server-side Next.js code only. If it ever reaches a NEXT_PUBLIC_ variable or a
# client component, every student record in the database is public (plan §4).

SUPABASE_URL=https://rvfiqaurtardlirgfera.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ENGINE_SHARED_SECRET=
REPORT_STORAGE_BUCKET=reports
SCORING_ENGINE_VERSION=1.0.0
LOG_LEVEL=INFO

# The base URL invite and review links are built against. Getting this wrong
# emails students a link to localhost, and the token in it cannot be reissued
# without minting another one.
APP_BASE_URL=http://localhost:3000

# Email. An EMPTY RESEND_API_KEY is a supported mode, not a broken one: the
# engine logs each message at WARNING and reports success, so a local tick
# drains the queue without mailing real students. The log line says NOT SENT.
# Set it and mail goes out for real, to whatever addresses the roster holds.
RESEND_API_KEY=
EMAIL_FROM=Percentile <noreply@example.invalid>

# Where job-failure and review-backlog alerts go. Unset means those alerts are
# logged and dropped rather than failing — an alert that failed would alert.
OPERATOR_ALERT_EMAIL=

# Job runner (plan §12). The defaults are sensible; these exist to be tuned
# without a deploy. JOB_STALE_TIMEOUT_SECONDS must exceed the longest a
# legitimate job can take — attempts are counted at claim time, so a job whose
# worker died is only recoverable through that timeout.
JOB_BATCH_SIZE=10
JOB_MAX_ATTEMPTS=5
JOB_STALE_TIMEOUT_SECONDS=1800
TICK_DEADLINE_SECONDS=90
REVIEW_BACKLOG_DAYS=5

# Optional. Enables the tests in engine/tests/db/, which apply the migrations and
# assert the R9 trigger and the RLS policies against a real server. Leave it
# empty and those tests skip; the rest of the suite is unaffected.
#
# DESTRUCTIVE: the harness runs `drop schema public cascade` before applying.
# Point this at a throwaway database only — never at the Supabase project above.
#   docker run -d --name pg-test -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
TEST_DATABASE_URL=
