# Copy to engine/.env and fill in. Never commit the filled file.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. It belongs here and in
# server-side Next.js code only. If it ever reaches a NEXT_PUBLIC_ variable or a
# client component, every student record in the database is public (plan §4).

SUPABASE_URL=https://rvfiqaurtardlirgfera.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ENGINE_SHARED_SECRET=
RESEND_API_KEY=
REPORT_STORAGE_BUCKET=reports
SCORING_ENGINE_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# Optional. Enables the tests in engine/tests/db/, which apply the migrations and
# assert the R9 trigger and the RLS policies against a real server. Leave it
# empty and those tests skip; the rest of the suite is unaffected.
#
# DESTRUCTIVE: the harness runs `drop schema public cascade` before applying.
# Point this at a throwaway database only — never at the Supabase project above.
#   docker run -d --name pg-test -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
TEST_DATABASE_URL=
